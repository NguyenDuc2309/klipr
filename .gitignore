parts/
stage/
prime/
.craft/
.snapcraft/
*.snap
*.rock


# Database (created at runtime, not shipped)
*.db

# Logs
log.txt

# Environment
.env
.env.local

# Settings (user-specific, created at runtime)
settings.json

# AI agent notes (local only)
.agent
.claude/
CLAUDE.md
claude.md
